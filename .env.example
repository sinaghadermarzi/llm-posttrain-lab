# Copy to .env (git-ignored). Read by posttrain_lab.utils.logging; variables
# already set in the pod environment take precedence over this file.
MLFLOW_TRACKING_URI=
# Only if the server is on a non-standard port that the URI above doesn't
# include, e.g. MLFLOW_PORT=5000. Leave empty for URIs on 80/443 or with a port.
MLFLOW_PORT=

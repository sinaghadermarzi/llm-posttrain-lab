# Copy to .env (git-ignored). Variables already set in the pod environment take
# precedence over this file. MLFLOW_* is read by posttrain_lab.utils.logging,
# RESULTS_DIR by the configs; HF_* is exported on `import posttrain_lab`,
# before any HF library reads it.
MLFLOW_TRACKING_URI=
# Only if the server is on a non-standard port that the URI above doesn't
# include, e.g. MLFLOW_PORT=5000. Leave empty for URIs on 80/443 or with a port.
MLFLOW_PORT=

# ---- Storage. Checkpoints + eval outputs need ~310 GB for both tracks
# (~250 helpful, ~60 math) and the HF cache ~22 GB, often more than the pod's
# home volume: put both on a bigger one. Use absolute paths; a relative
# RESULTS_DIR is taken from the repo root. Empty = results/ in the repo and
# ~/.cache/huggingface. Restart notebook kernels after changing HF_HOME.
RESULTS_DIR=
HF_HOME=

# ---- Hugging Face assets on the offline cluster (README: "Offline cluster").
# Pick ONE option; `python -m posttrain_lab.preflight hf` checks the result.
# `accelerate launch`, lm-eval and vLLM workers inherit these from the process.
#
# Option A: internal Hub mirror / proxy (Artifactory, Nexus, a self-hosted
# huggingface.co proxy). Downloads land in HF_HOME as usual.
# HF_TOKEN only if the mirror (or a gated repo) needs one; HF_HOME (above) on
# a PVC keeps the downloads across pods.
# HF_ENDPOINT=https://hf-mirror.internal.example
# HF_TOKEN=
#
# Option B: pre-populated cache on a PVC, filled by scripts/prefetch_assets.py
# on a machine with internet. Set HF_HOME (above) to its mount point; leave
# HF_HUB_CACHE / HF_DATASETS_CACHE unset so both resolve under HF_HOME.
# HF_HUB_OFFLINE=1
# HF_DATASETS_OFFLINE=1
